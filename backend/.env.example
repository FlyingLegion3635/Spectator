NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Database Configuration
# DB_TYPE determines which database backend to use.
# Supported values: firestore, sql, mongo
DB_TYPE=firestore

# SQL Configuration (When DB_TYPE=sql)
# DB_CLIENT supports pg (PostgreSQL), mysql2 (MySQL/MariaDB), better-sqlite3, tedious (MSSQL)
DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=spectator

# MongoDB Configuration (when DB_TYPE=mongo)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=spectator

# Firestore Configuration (when DB_TYPE=firestore)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
FIREBASE_DATABASE_URL=

# Optional Features
ENABLE_SIGNUP=true

# Passkeys / WebAuthn
ENABLE_PASSKEYS=false
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Spectator
PASSKEY_RP_ORIGIN=http://localhost:3000

# The Blue Alliance API
TBA_API_KEY=
